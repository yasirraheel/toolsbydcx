{
  "manifest_version": 3,
  "name": "ToolsByDcx",
  "version": "1.4",
  "description": "AI Access Platform — Unlock Google Flow and AI tools with your ToolsByDcx plan.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "management",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://toolsbydcx.com/*",
    "https://*.toolsbydcx.com/*",
    "https://flowbydcx.com/*",
    "https://*.flowbydcx.com/*",
    "http://localhost/*",
    "http://localhost:3000/*",
    "http://localhost:5000/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:5000/*",
    "https://*.google.com/*",
    "https://accounts.google.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "bf_early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "bf_watchdog_isolated.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "bf_watchdog_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/api/auth/signout*"
      ],
      "js": [
        "persistent_lock.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "bf_perf_guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "flow_overrides.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "bf_model_hide.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "dcx_extra.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/api/auth/signout*"
      ],
      "js": [
        "auto_signout.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/api/auth/signout*"
      ],
      "js": [
        "auto_signout.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://toolsbydcx.com/*",
        "https://*.toolsbydcx.com/*",
        "https://flowbydcx.com/*",
        "https://*.flowbydcx.com/*",
        "http://localhost/*",
        "http://localhost:3000/*",
        "http://localhost:5000/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:5000/*"
      ],
      "js": [
        "site_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://*.google.com/*"
      ],
      "js": [
        "bf_watchdog.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/flow/about*",
        "https://labs.google/flow",
        "https://labs.google/"
      ],
      "js": [
        "bf_about.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/api/auth/signout*"
      ],
      "js": [
        "bf_signout_click.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://accounts.google.com/*"
      ],
      "js": [
        "bf_switch_account.js"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "bf_landing_reload.js"
      ],
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}